{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-header-fix/types/**/*.ts",
    ".next-language-final/types/**/*.ts",
    ".next-language/types/**/*.ts",
    ".next-layout/types/**/*.ts",
    ".next-learn-final/types/**/*.ts",
    ".next-learn-main/types/**/*.ts",
    ".next-quality-after/types/**/*.ts",
    ".next-quality-final/types/**/*.ts",
    ".next-quality/types/**/*.ts",
    ".next-test/types/**/*.ts",
    ".next-ux-audit/types/**/*.ts",
    ".next-v4-baseline/types/**/*.ts",
    ".next-v4-complete/types/**/*.ts",
    ".next-v4-final/types/**/*.ts",
    ".next-v4/types/**/*.ts",
    ".next-v5-complete/types/**/*.ts",
    ".next-v5-dev/types/**/*.ts",
    ".next-v5-final/types/**/*.ts",
    ".next-v5-reviewed/types/**/*.ts",
    ".next-v5/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-ux-build/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
