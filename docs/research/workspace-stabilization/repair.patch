+import type { FocusEvent } from "react";
+
+/** Bring code into a short activity pane on entry, without moving the caret or
+ * the document page. Runs once per focus entry, never on typing or results. */
+export function focusWorkspaceEditor(event: FocusEvent<HTMLElement>) {
+  const content = event.target;
+  const pane = event.currentTarget;
+  if (!(content instanceof HTMLElement) || !content.classList.contains("cm-content")) return;
+  if (pane.clientHeight >= 500 && !window.matchMedia("(max-width: 899px)").matches) return;
+  requestAnimationFrame(() => {
+    if (!pane.isConnected || document.activeElement !== content) return;
+    const editor = content.closest<HTMLElement>(".cm-editor");
+    if (!editor || !pane.contains(editor)) return;
+    const split = pane.parentElement;
+    if (window.matchMedia("(max-width: 899px)").matches && pane.clientHeight < 260 &&
+        split?.matches(".rx-task-split, .p2-split") && split.clientHeight >= 324) {
+      // Default remains 50/50. While typing, retain at least 64px of reading
+      // space and give code/actions enough room in a constrained work pane.
+      split.style.setProperty("--workspace-work-height", `${Math.min(split.clientHeight - 64, Math.max(260, split.clientHeight * 0.65))}px`);
+      split.setAttribute("data-editor-focus", "true");
+    }
+    const top = editor.getBoundingClientRect().top - pane.getBoundingClientRect().top - pane.clientTop;
+    // Leave a little room for the editor's focus outline. Scrolling only the
+    // owning pane also preserves the independent reading pane's position.
+    pane.scrollTop += top - 12;
+  });
+}
+
+/** Keep the editing allocation while focus stays anywhere in this work pane,
+ * including Run/Check. Collapse only on leaving the pane, so a held pointer or
+ * keyboard move to an action never moves that action before activation. */
+export function releaseWorkspaceEditor(event: FocusEvent<HTMLElement>) {
+  const pane = event.currentTarget;
+  requestAnimationFrame(() => {
+    if (!pane.isConnected) return;
+    const active = document.activeElement;
+    if (active && pane.contains(active)) return;
+    const split = pane.parentElement;
+    split?.removeAttribute("data-editor-focus");
+    split?.style.removeProperty("--workspace-work-height");
+  });
+}
