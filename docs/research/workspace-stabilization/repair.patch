+const csv = "id\n1\n";
+const bytes = () => new TextEncoder().encode(csv).buffer as ArrayBuffer;
+const mount = { path: "data/a.csv", url: "/a.csv", sha256: createHash("sha256").update(csv).digest("hex") };
