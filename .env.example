# PostHog product analytics (optional). Copy to .env.local and paste your project key.
# https://us.posthog.com/ — Project settings → Project API key
NEXT_PUBLIC_POSTHOG_KEY=
# Optional; defaults to the US cloud host.
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Waitlist emails for subjects that are not open yet (Resend).
# https://resend.com/api-keys — free tier works; onboarding@resend.dev can only mail your account email.
RESEND_API_KEY=
# Resend Audience → Topics IDs (one per gated subject). Used to store waitlist signups.
# RESEND_TOPIC_PYTHON=
# RESEND_TOPIC_PYSPARK=
# RESEND_TOPIC_POWER_BI=
# RESEND_TOPIC_ML=
# RESEND_TOPIC_AI_ENGINEERING=
# NOTIFY_TO_EMAIL=krishnasathvikm@gmail.com
# After you verify a domain in Resend, set a from address on that domain:
# NOTIFY_FROM_EMAIL=Runtime Waitlist <hello@yourdomain.com>
