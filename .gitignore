# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-*/
/.playwright-cli/
/.playwright-mcp/
/out/

# local deploy hygiene
.archive-location
/sqlstudio-archive/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# Private third-party reference material (never published)
/reference/
/docs/audit/SQL_Studio_29_Source_Documents_V4.zip

# Pyodide core, copied and hash-verified from node_modules by scripts/copy-pyodide.mjs
/public/vendor/pyodide/

# Python course research pack: the zip and reference PDFs stay local (copyrighted, large)
/research/**/*.zip
/research/**/*.pdf
.py-dump/

# Reproducible SQL dataset editions (npm run datasets:build)
/public/datasets/

# Generated by scripts/canonical-e2e-fixtures.gen.ts
/tests/e2e/.canonical-fixtures.json
.vercel

# Python master agent pack: private research input (copyrighted PDFs), never committed
/runtime_school_python_master_agent_pack.zip
/docs/runtime_school_python_master_agent_pack.zip

# PySpark handoff: the uploaded reference PDFs stay local (copyrighted, ~16 MB). Curriculum files in PySpark Docs/ are tracked.
/PySpark Docs/references/uploaded_pdfs/

# Spark runner: Python bytecode from local test runs
/services/**/__pycache__/

# PySpark assessment references and hidden fixtures must never enter public history.
/services/spark-runner/private/
