{
  "name": "sql-studio-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-pyodide.mjs",
    "predev": "npm run datasets:canonical && npm run datasets:python && node scripts/copy-pyodide.mjs",
    "dev": "next dev --turbopack",
    "prebuild": "npm run datasets:canonical && npm run datasets:python && node scripts/copy-pyodide.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/acceptance.mjs",
    "test:shortcuts": "node tests/e2e/shortcuts.mjs",
    "test:layout": "node tests/e2e/layout.mjs",
    "test:sweep": "node tests/e2e/sweep.mjs",
    "test:a11y": "node tests/e2e/axe.mjs",
    "qb:report": "npm run datasets:canonical && vitest run --config vitest.scripts.config.ts scripts/workspace-context.gen.ts scripts/canonical-audit.gen.ts",
    "test:learner": "node tests/e2e/learner-quality.mjs",
    "test:learning": "node tests/e2e/learning-experience.mjs",
    "test:v4": "node tests/e2e/v4.mjs",
    "test:language": "node tests/e2e/content-language.mjs",
    "test:v5": "node tests/e2e/v5.mjs",
    "test:python-runtime": "node tests/e2e/python-runtime.mjs",
    "test:python-grading": "node tests/e2e/python-grading.mjs",
    "test:python-workspace": "node tests/e2e/python-workspace.mjs",
    "test:python-lesson": "node tests/e2e/python-lesson.mjs",
    "test:python-lesson-2": "node tests/e2e/python-lesson-2.mjs",
    "test:python-packages": "node tests/e2e/python-packages.mjs",
    "test:python-isolation": "node tests/e2e/python-isolation.mjs",
    "typecheck:sql": "tsc --noEmit --project tsconfig.sql-check.json",
    "test:sql": "vitest run --exclude \"**/python*\"",
    "test:datasets:e2e": "node tests/e2e/dataset-library.mjs && node tests/e2e/dataset-flows.mjs && node tests/e2e/dataset-benchmarks.mjs",
    "datasets:canonical": "node datasets/build.mjs",
    "datasets:python": "node datasets/python/build.mjs",
    "py:registry": "node scripts/python-v2/import-catalog.mjs",
    "py:coverage": "vitest run --config vitest.scripts.config.ts scripts/python-v2/coverage.gen.ts",
    "datasets:acquire": "node datasets/acquire/download.mjs",
    "test:canonical": "vitest run tests/canonical",
    "test:canonical:e2e": "vitest run --config vitest.scripts.config.ts scripts/canonical-e2e-fixtures.gen.ts && node tests/e2e/canonical.mjs && node tests/e2e/canonical-network.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@pdf-lib/fontkit": "^1.1.1",
    "@uiw/react-codemirror": "^4.25.12",
    "idb": "^8.0.4",
    "lucide-react": "^1.53.0",
    "next": "^15.5.9",
    "pdf-lib": "^1.17.1",
    "posthog-js": "^1.438.9",
    "pyodide": "314.0.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sql.js": "^1.14.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sql.js": "^1.4.11",
    "eslint": "^9",
    "eslint-config-next": "^15.5.9",
    "fflate": "0.4.9",
    "hyparquet": "^1.31.4",
    "jsdom": "^29.1.1",
    "playwright": "^1.55.0",
    "saxes": "6.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
